# Isi secret hanya di .env.local atau secret provider; jangan taruh nilainya di chat.
# Environment tervalidasi server-side pada task M06-SETUP-05.

# DATABASE_URL: Neon Console > project/branch > Connect > aktifkan Pooled connection.
# Server-only; jangan tempel connection string ke chat atau commit.
DATABASE_URL=

# DIRECT_URL: dari Connect yang sama dengan Pooled connection dimatikan.
# Server/migrasi saja; jangan expose ke browser.
DIRECT_URL=

# NEON_AUTH_BASE_URL: Auth URL untuk branch yang dipakai, setelah Neon Auth diaktifkan.
# Bisa diperoleh dari halaman Auth branch atau ditarik oleh Neon CLI ke .env.local.
NEON_AUTH_BASE_URL=

# NEON_AUTH_COOKIE_SECRET: secret acak untuk menandatangani cache sesi server SDK Neon Auth.
# Buat dengan Node.js: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64url'))"
# Simpan hanya di .env.local/secret provider; minimal 32 karakter, bukan secret dari Neon.
NEON_AUTH_COOKIE_SECRET=

# Isi setelah private bucket dibuat pada branch Neon yang sama.
# Petakan AWS_ENDPOINT_URL_S3, AWS_ACCESS_KEY_ID, dan AWS_SECRET_ACCESS_KEY dari Neon ke variabel ini.
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_ACCESS_KEY=
NEON_STORAGE_SECRET_KEY=

# Tetapkan sendiri: http://localhost:3000 untuk lokal; origin HTTPS deployment untuk live.
APP_ORIGIN=

# Buat sendiri sebagai secret acak minimal 16 karakter; bukan nilai dari Neon.
CRON_SECRET=
