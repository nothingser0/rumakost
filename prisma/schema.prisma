generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  OWNER
  STAFF
  TENANT
}

enum RoomPhysicalStatus {
  READY
  CLEANING
  MAINTENANCE
}

enum BillingMode {
  PRORATA_TO_MONTH_END
  FULL_MONTH_ANNIVERSARY
}

enum LeaseStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

enum LeaseEndRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  ISSUED
  VOID
}

enum InvoiceDeliveryStatus {
  UNSENT
  SENT
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum RefundStatus {
  PENDING
  PAID
  REJECTED
}

enum TicketPriority {
  LOW
  NORMAL
  URGENT
}

enum TicketCategory {
  AC
  PLUMBING
  ELECTRICAL
  FURNITURE
  GENERAL
  DOORS_LOCKS
}

enum TicketStatus {
  RECEIVED
  ASSIGNED
  IN_PROGRESS
  INSPECTION
  RESOLVED
  CANCELLED
  DRAFT
}

enum CommentVisibility {
  TENANT_VISIBLE
  INTERNAL
}

enum TicketUploadStatus {
  PENDING_UPLOAD
  AVAILABLE
  DELETE_PENDING
  DELETED
  FAILED
}

model AppUser {
  id                 String   @id @default(uuid()) @db.Uuid
  authSubject        String   @unique @map("auth_subject")
  /// Canonical provider-confirmed email: lowercase, with no leading/trailing ASCII spaces. Enforced by SQL CHECK migration.
  emailNormalized    String   @unique @map("email_normalized")
  displayName        String   @map("display_name")
  role               AppRole
  isActive           Boolean  @default(true) @map("is_active")
  mustChangePassword Boolean  @default(true) @map("must_change_password")
  createdById        String?  @map("created_by_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy                   AppUser?             @relation("AppUserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdUsers                AppUser[]            @relation("AppUserCreatedBy")
  tenantProfile               TenantProfile?
  tenantLeases                Lease[]              @relation("LeaseTenant")
  createdLeases               Lease[]              @relation("LeaseCreatedBy")
  requestedLeaseEndRequests   LeaseEndRequest[]    @relation("LeaseEndRequestRequestedBy")
  reviewedLeaseEndRequests    LeaseEndRequest[]    @relation("LeaseEndRequestReviewedBy")
  recordedPayments            Payment[]            @relation("PaymentRecordedBy")
  verifiedPayments            Payment[]            @relation("PaymentVerifiedBy")
  rejectedPayments            Payment[]            @relation("PaymentRejectedBy")
  createdDepositLedgerEntries DepositLedgerEntry[]
  createdPaymentReversals     PaymentReversal[]    @relation("PaymentReversalCreatedBy")
  recordedExpenses            Expense[]
  createdExpenseReversals     ExpenseReversal[]    @relation("ExpenseReversalCreatedBy")
  createdTickets              Ticket[]             @relation("TicketCreatedBy")
  assignedTickets             Ticket[]             @relation("TicketAssignedTo")
  statusChangedTickets        Ticket[]             @relation("TicketStatusChangedBy")
  cancelledTickets            Ticket[]             @relation("TicketCancelledBy")
  ticketStatusEvents          TicketStatusEvent[]  @relation("TicketStatusEventActor")
  authoredTicketComments      TicketComment[]
  uploadedTicketAttachments   TicketAttachment[]
  auditEvents                 AuditEvent[]
  updatedOperatingBudgets     OperatingBudget[]    @relation("OperatingBudgetUpdatedBy")

  @@index([createdById])
  @@map("app_users")
}

model TenantProfile {
  userId                    String  @id @map("user_id") @db.Uuid
  phoneE164                 String? @map("phone_e164") @db.VarChar(16)
  occupation                String? @db.VarChar(100)
  employer                  String? @db.VarChar(150)
  cityOfOrigin              String? @map("city_of_origin") @db.VarChar(100)
  emergencyContactName      String? @map("emergency_contact_name") @db.VarChar(100)
  emergencyContactRelation  String? @map("emergency_contact_relation") @db.VarChar(50)
  emergencyContactPhoneE164 String? @map("emergency_contact_phone_e164") @db.VarChar(16)
  emergencyContactNote      String? @map("emergency_contact_note")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("tenant_profiles")
}

model Floor {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String    @unique @map("normalized_name")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  rooms          Room[]

  @@map("floors")
}

model Room {
  id                   String             @id @default(uuid()) @db.Uuid
  code                 String             @unique
  floorId              String?            @map("floor_id") @db.Uuid
  roomType             String?            @map("room_type")
  widthMeters          Decimal?           @map("width_m") @db.Decimal(5, 2)
  lengthMeters         Decimal?           @map("length_m") @db.Decimal(5, 2)
  monthlyRent          Decimal            @map("monthly_rent") @db.Decimal(12, 2)
  depositDefaultAmount Decimal            @map("deposit_default_amount") @db.Decimal(12, 2)
  physicalStatus       RoomPhysicalStatus @default(READY) @map("physical_status")
  maintenanceNote      String?            @map("maintenance_note") @db.VarChar(500)
  archivedAt           DateTime?          @map("archived_at") @db.Timestamptz(6)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  floor                Floor?             @relation(fields: [floorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  leases               Lease[]
  tickets              Ticket[]

  @@index([floorId])
  @@index([archivedAt])
  @@map("rooms")
}

model Lease {
  id                   String               @id @default(uuid()) @db.Uuid
  tenantUserId         String               @map("tenant_user_id") @db.Uuid
  roomId               String               @map("room_id") @db.Uuid
  startsOn             DateTime             @map("starts_on") @db.Date
  endsOn               DateTime?            @map("ends_on") @db.Date
  rentAmount           Decimal              @map("rent_amount") @db.Decimal(12, 2)
  depositAgreedAmount  Decimal              @default(0) @map("deposit_agreed_amount") @db.Decimal(12, 2)
  billingMode          BillingMode          @map("billing_mode")
  status               LeaseStatus
  contractNumber       String?              @unique @map("contract_number")
  createdById          String               @map("created_by_id") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  invoices             Invoice[]
  depositLedgerEntries DepositLedgerEntry[]
  tickets              Ticket[]

  tenant      AppUser           @relation("LeaseTenant", fields: [tenantUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  room        Room              @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy   AppUser           @relation("LeaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  endRequests LeaseEndRequest[]

  @@unique([id, tenantUserId])
  @@index([tenantUserId])
  @@index([roomId, startsOn, endsOn])
  @@index([createdById])
  @@map("leases")
}

model LeaseEndRequest {
  id                  String                @id @default(uuid()) @db.Uuid
  leaseId             String                @map("lease_id") @db.Uuid
  requestedByTenantId String                @map("requested_by_tenant_id") @db.Uuid
  requestedEndOn      DateTime              @map("requested_end_on") @db.Date
  reason              String?
  status              LeaseEndRequestStatus @default(PENDING)
  reviewedByOwnerId   String?               @map("reviewed_by_owner_id") @db.Uuid
  reviewedAt          DateTime?             @map("reviewed_at") @db.Timestamptz(6)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  lease             Lease    @relation(fields: [leaseId, requestedByTenantId], references: [id, tenantUserId], onDelete: Restrict, onUpdate: Cascade, map: "lease_end_requests_lease_requester_fkey")
  requestedByTenant AppUser  @relation("LeaseEndRequestRequestedBy", fields: [requestedByTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewedByOwner   AppUser? @relation("LeaseEndRequestReviewedBy", fields: [reviewedByOwnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([leaseId])
  @@index([requestedByTenantId])
  @@index([reviewedByOwnerId])
  @@map("lease_end_requests")
}

model Invoice {
  id             String                @id @default(uuid()) @db.Uuid
  leaseId        String                @map("lease_id") @db.Uuid
  periodStart    DateTime              @map("period_start") @db.Date
  periodEnd      DateTime              @map("period_end") @db.Date
  dueOn          DateTime              @map("due_on") @db.Date
  kind           String
  status         InvoiceStatus         @default(ISSUED)
  issuedAt       DateTime              @default(now()) @map("issued_at") @db.Timestamptz(6)
  deliveryStatus InvoiceDeliveryStatus @default(UNSENT) @map("delivery_status")
  voidedAt       DateTime?             @map("voided_at") @db.Timestamptz(6)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  lines    InvoiceLine[]
  payments Payment[]

  lease Lease @relation(fields: [leaseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([leaseId, periodStart, periodEnd, kind])
  @@map("invoices")
}

model InvoiceLine {
  id                   String               @id @default(uuid()) @db.Uuid
  invoiceId            String               @map("invoice_id") @db.Uuid
  kind                 String
  amount               Decimal              @db.Decimal(12, 2)
  description          String
  allocations          PaymentAllocation[]
  depositLedgerEntries DepositLedgerEntry[]

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id              String              @id @default(uuid()) @db.Uuid
  invoiceId       String              @map("invoice_id") @db.Uuid
  amount          Decimal             @db.Decimal(12, 2)
  method          String
  reference       String?             @unique
  status          PaymentStatus       @default(PENDING)
  recordedById    String              @map("recorded_by_id") @db.Uuid
  verifiedById    String?             @map("verified_by_id") @db.Uuid
  verifiedAt      DateTime?           @map("verified_at") @db.Timestamptz(6)
  rejectedById    String?             @map("rejected_by_id") @db.Uuid
  rejectedAt      DateTime?           @map("rejected_at") @db.Timestamptz(6)
  rejectionReason String?             @map("rejection_reason")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  allocations     PaymentAllocation[]
  reversal        PaymentReversal?

  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recordedBy AppUser  @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  verifiedBy AppUser? @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rejectedBy AppUser? @relation("PaymentRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([invoiceId])
  @@index([recordedById])
  @@index([verifiedById])
  @@index([rejectedById])
  @@map("payments")
}

model PaymentAllocation {
  id                        String              @id @default(uuid()) @db.Uuid
  paymentId                 String              @map("payment_id") @db.Uuid
  invoiceLineId             String              @map("invoice_line_id") @db.Uuid
  amount                    Decimal             @db.Decimal(12, 2)
  depositLedgerEntry        DepositLedgerEntry?
  depositCollectionReversal DepositLedgerEntry? @relation("ReversedDepositCollection")

  payment     Payment     @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  invoiceLine InvoiceLine @relation(fields: [invoiceLineId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([paymentId, invoiceLineId])
  @@index([invoiceLineId])
  @@map("payment_allocations")
}

model DepositLedgerEntry {
  id                          String        @id @default(uuid()) @db.Uuid
  leaseId                     String        @map("lease_id") @db.Uuid
  invoiceLineId               String?       @map("invoice_line_id") @db.Uuid
  paymentAllocationId         String?       @unique @map("payment_allocation_id") @db.Uuid
  reversedPaymentAllocationId String?       @unique @map("reversed_payment_allocation_id") @db.Uuid
  kind                        String
  amount                      Decimal       @db.Decimal(12, 2)
  reason                      String?
  refundStatus                RefundStatus? @map("refund_status")
  createdById                 String        @map("created_by_id") @db.Uuid
  createdAt                   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  lease                     Lease              @relation(fields: [leaseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  invoiceLine               InvoiceLine?       @relation(fields: [invoiceLineId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  paymentAllocation         PaymentAllocation? @relation(fields: [paymentAllocationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversedPaymentAllocation PaymentAllocation? @relation("ReversedDepositCollection", fields: [reversedPaymentAllocationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy                 AppUser            @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([leaseId])
  @@index([invoiceLineId])
  @@index([createdById])
  @@map("deposit_ledger_entries")
}

model PaymentReversal {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String   @unique @map("payment_id") @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy AppUser @relation("PaymentReversalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([createdById])
  @@map("payment_reversals")
}

model IdempotencyKey {
  key             String    @id @db.Uuid
  operation       String
  responseCode    Int?      @map("response_code")
  responsePayload Json?     @map("response_payload") @db.JsonB
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("idempotency_keys")
}

model Expense {
  id           String   @id @default(uuid()) @db.Uuid
  category     String
  amount       Decimal  @db.Decimal(12, 2)
  occurredOn   DateTime @map("occurred_on") @db.Date
  description  String
  recordedById String   @map("recorded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  recordedBy AppUser          @relation(fields: [recordedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversal   ExpenseReversal?

  @@index([occurredOn])
  @@index([recordedById])
  @@map("expenses")
}

model ExpenseReversal {
  id          String   @id @default(uuid()) @db.Uuid
  expenseId   String   @unique @map("expense_id") @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy AppUser @relation("ExpenseReversalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([createdById])
  @@map("expense_reversals")
}

model OperatingBudget {
  id          String   @id @default(uuid()) @db.Uuid
  periodStart DateTime @unique @map("period_start") @db.Date
  amount      Decimal  @db.Decimal(12, 2)
  updatedById String   @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy AppUser @relation("OperatingBudgetUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([updatedById])
  @@map("operating_budgets")
}

model Ticket {
  id                   String         @id @default(uuid()) @db.Uuid
  ticketNumber         BigInt         @unique @default(autoincrement()) @map("ticket_number")
  roomId               String         @map("room_id") @db.Uuid
  leaseId              String?        @map("lease_id") @db.Uuid
  createdById          String         @map("created_by_id") @db.Uuid
  statusChangedById    String?        @map("status_changed_by_id") @db.Uuid
  assignedToId         String?        @map("assigned_to_id") @db.Uuid
  cancelledById        String?        @map("cancelled_by_id") @db.Uuid
  title                String
  description          String
  category             TicketCategory
  priority             TicketPriority
  status               TicketStatus   @default(DRAFT)
  resolutionSummary    String?        @map("resolution_summary")
  cancellationReason   String?        @map("cancellation_reason")
  closedAt             DateTime?      @map("closed_at") @db.Timestamptz(6)
  reopenedAt           DateTime?      @map("reopened_at") @db.Timestamptz(6)
  cancelledAt          DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  targetCompletionOn   DateTime?      @map("target_completion_on") @db.Date
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  room            Room                @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lease           Lease?              @relation(fields: [leaseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy       AppUser             @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  statusChangedBy AppUser?            @relation("TicketStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedTo      AppUser?            @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cancelledBy     AppUser?            @relation("TicketCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  comments        TicketComment[]
  attachments     TicketAttachment[]
  statusEvents    TicketStatusEvent[]

  @@index([roomId])
  @@index([leaseId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([status, createdAt(sort: Desc)])
  @@index([category, status, createdAt(sort: Desc)])
  @@map("tickets")
}

model TicketStatusEvent {
  id                String        @id @default(uuid()) @db.Uuid
  ticketId          String        @map("ticket_id") @db.Uuid
  fromStatus        TicketStatus? @map("from_status")
  toStatus          TicketStatus  @map("to_status")
  actorId           String        @map("actor_id") @db.Uuid
  reason            String?
  resolutionSummary String?       @map("resolution_summary")
  occurredAt        DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)

  ticket Ticket  @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor  AppUser @relation("TicketStatusEventActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ticketId, occurredAt])
  @@index([actorId])
  @@map("ticket_status_events")
}

model TicketComment {
  id         String            @id @default(uuid()) @db.Uuid
  ticketId   String            @map("ticket_id") @db.Uuid
  authorId   String            @map("author_id") @db.Uuid
  body       String
  visibility CommentVisibility
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  author      AppUser            @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attachments TicketAttachment[] @relation("TicketCommentAttachments")

  @@unique([id, ticketId])
  @@index([ticketId, createdAt])
  @@index([authorId])
  @@map("ticket_comments")
}

model TicketAttachment {
  id              String             @id @default(uuid()) @db.Uuid
  ticketId        String             @map("ticket_id") @db.Uuid
  commentId       String?            @map("comment_id") @db.Uuid
  uploadedById    String             @map("uploaded_by_id") @db.Uuid
  uploadBatchId   String             @default(uuid()) @map("upload_batch_id") @db.Uuid
  objectKey       String             @unique @map("object_key")
  mimeType        String             @map("mime_type")
  sizeBytes       BigInt             @map("size_bytes")
  durationSeconds Int?               @map("duration_seconds")
  uploadStatus    TicketUploadStatus @default(PENDING_UPLOAD) @map("upload_status")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  deleteAfter     DateTime?          @map("delete_after") @db.Timestamptz(6)
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(6)

  ticket     Ticket         @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  comment    TicketComment? @relation("TicketCommentAttachments", fields: [commentId, ticketId], references: [id, ticketId], onDelete: Restrict, onUpdate: Cascade)
  uploadedBy AppUser        @relation(fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ticketId])
  @@index([commentId, ticketId])
  @@index([uploadedById])
  @@index([uploadBatchId])
  @@index([deleteAfter])
  @@map("ticket_attachments")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id") @db.Uuid
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  reason       String?
  safeMetadata Json     @default("{}") @map("safe_metadata") @db.JsonB

  actor AppUser? @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([actorId])
  @@index([entityType, entityId, occurredAt(sort: Desc)])
  @@map("audit_events")
}
